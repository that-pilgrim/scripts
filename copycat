#!/bin/bash
# copycat - Copy file contents to clipboard (CLIPBOARD + PRIMARY)
# Usage: copycat <filename>
#        some_command | copycat
#
# Env: OSC52_MAX  max base64 bytes to send via OSC52 (default 100000)

OSC52_MAX="${OSC52_MAX:-100000}"

# Input: file argument or stdin
if [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        echo "Usage: copycat <filename>"
        echo "Copies the contents of a file to the clipboard"
        exit 1
    fi
    src="-"
    label="stdin"
else
    src="$1"
    label="'$1'"
    if [ ! -f "$src" ]; then
        echo "Error: File '$src' not found" >&2
        exit 1
    fi
fi

# Stream the input into a temp file so every method gets exact bytes
tmp=$(mktemp "${TMPDIR:-/tmp}/copycat.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT
if [ "$src" = "-" ]; then cat > "$tmp"; else cat -- "$src" > "$tmp"; fi

if [ ! -s "$tmp" ]; then
    echo "Warning: $label is empty, nothing copied" >&2
    exit 1
fi

copy_via_osc52() {
    local encoded size
    encoded=$(base64 < "$tmp" | tr -d '\n\r')
    size=${#encoded}

    if [ "$size" -gt "$OSC52_MAX" ]; then
        echo "Warning: $size bytes (base64) exceeds OSC52 limit of $OSC52_MAX." >&2
        echo "Many terminals will silently drop this. Raise OSC52_MAX to try anyway." >&2
        return 1
    fi

    local out=/dev/tty
    [ -w "$out" ] || out=/dev/stdout

    # "pc" = set both PRIMARY (Shift+Insert) and CLIPBOARD (Ctrl+V)
    if [ -n "$TMUX" ]; then
        printf '\033Ptmux;\033\033]52;pc;%s\a\033\\' "$encoded" > "$out"
    elif [[ "$TERM" == screen* ]]; then
        printf '\033P\033]52;pc;%s\a\033\\' "$encoded" > "$out"
    else
        printf '\033]52;pc;%s\a' "$encoded" > "$out"
    fi
}

ok() { echo "Contents of $label copied to clipboard ($(wc -c < "$tmp" | tr -d ' ') bytes)"; }

if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
    if copy_via_osc52; then
        echo "Contents of $label sent to local clipboard via OSC52"
        echo "(Make sure your terminal supports OSC52 clipboard integration)"
    else
        exit 1
    fi
elif command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$tmp" && ok
elif [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then
    wl-copy < "$tmp" && wl-copy --primary < "$tmp" && ok
elif [ -n "$DISPLAY" ] && command -v xclip >/dev/null 2>&1; then
    # Set both selections; each xclip forks to hold its selection
    xclip -selection clipboard -in < "$tmp" >/dev/null 2>&1 \
        && xclip -selection primary -in < "$tmp" >/dev/null 2>&1 && ok
elif [ -n "$DISPLAY" ] && command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input < "$tmp" >/dev/null 2>&1 \
        && xsel --primary --input < "$tmp" >/dev/null 2>&1 && ok
elif command -v clip.exe >/dev/null 2>&1; then
    clip.exe < "$tmp" && ok
else
    echo "No clipboard utility available. Contents of $label:"
    echo "=========================================="
    cat "$tmp"
    echo "=========================================="
fi
