#!/usr/bin/env bash
# copycat - Copy file contents (or stdin) to the clipboard, on any system.
#
# Usage:  copycat <filename>
#         some_command | copycat
#         copycat --test            send "COPYCAT_TEST" to verify OSC52 works
#
# Env overrides:
#   COPYCAT_METHOD=auto|native|osc52|file   (default: auto)
#   OSC52_TARGET=c|p|pc|s                   (default: c)
#   OSC52_TERM=bel|st                       (default: bel)
#   OSC52_MAX=<bytes>                       max base64 size (default 100000)
#   COPYCAT_FORCE=1                         ignore the size limit
#   COPYCAT_QUIET=1                         suppress status messages

OSC52_MAX="${OSC52_MAX:-100000}"
OSC52_TARGET="${OSC52_TARGET:-c}"
OSC52_TERM="${OSC52_TERM:-bel}"
METHOD="${COPYCAT_METHOD:-auto}"
OS="$(uname -s 2>/dev/null)"

have() { command -v "$1" >/dev/null 2>&1; }
msg()  { [ -n "${COPYCAT_QUIET:-}" ] || echo "$@" >&2; }

is_ssh() { [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; }
is_wsl() { [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; }
is_winposix() { case "$OS" in CYGWIN*|MSYS*|MINGW*) return 0;; esac; return 1; }
can_tty() { ( : > /dev/tty ) 2>/dev/null; }

# ---------- Input ----------
tmp=$(mktemp "${TMPDIR:-/tmp}/copycat.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

if [ "$1" = "--test" ]; then
    printf 'COPYCAT_TEST' > "$tmp"
    label="test string"
    [ "$METHOD" = "auto" ] && METHOD="osc52"
elif [ $# -eq 0 ]; then
    if [ -t 0 ]; then
        echo "Usage: copycat <filename>"
        echo "       some_command | copycat"
        echo "       copycat --test"
        exit 1
    fi
    label="stdin"
    cat > "$tmp"
else
    label="'$1'"
    if [ ! -f "$1" ]; then
        echo "Error: File '$1' not found" >&2
        exit 1
    fi
    cat -- "$1" > "$tmp"
fi

if [ ! -s "$tmp" ]; then
    msg "Warning: $label is empty, nothing copied"
    exit 1
fi
bytes=$(wc -c < "$tmp" | tr -d ' ')

# ---------- Native clipboard tools ----------
METHOD_USED=""
copy_native() {
    if [ "$OS" = "Darwin" ] && have pbcopy; then
        METHOD_USED="pbcopy"; pbcopy < "$tmp"
    elif have termux-clipboard-set; then
        METHOD_USED="termux-clipboard-set"; termux-clipboard-set < "$tmp"
    elif is_winposix && [ -c /dev/clipboard ]; then
        METHOD_USED="/dev/clipboard"; cat "$tmp" > /dev/clipboard
    elif is_wsl && have win32yank.exe; then
        METHOD_USED="win32yank.exe"; win32yank.exe -i < "$tmp"
    elif have clip.exe && { is_wsl || is_winposix; }; then
        METHOD_USED="clip.exe"
        if have iconv; then
            { printf '\377\376'; iconv -f UTF-8 -t UTF-16LE "$tmp"; } | clip.exe
        else
            clip.exe < "$tmp"
        fi
    elif [ -n "${WAYLAND_DISPLAY:-}" ] && have wl-copy; then
        METHOD_USED="wl-copy"
        wl-copy < "$tmp" >/dev/null 2>&1 && { wl-copy --primary < "$tmp" >/dev/null 2>&1 || true; }
    elif [ -n "${DISPLAY:-}" ] && have xclip; then
        METHOD_USED="xclip"
        xclip -selection clipboard -in < "$tmp" >/dev/null 2>&1 \
            && { xclip -selection primary -in < "$tmp" >/dev/null 2>&1 || true; }
    elif [ -n "${DISPLAY:-}" ] && have xsel; then
        METHOD_USED="xsel"
        xsel --clipboard --input < "$tmp" >/dev/null 2>&1 \
            && { xsel --primary --input < "$tmp" >/dev/null 2>&1 || true; }
    else
        return 1
    fi
}

# ---------- OSC52 ----------
copy_osc52() {
    can_tty || { msg "No controlling terminal (/dev/tty) available for OSC52"; return 1; }

    local encoded
    if have base64; then
        encoded=$(base64 < "$tmp" | tr -d '\n\r')
    elif have openssl; then
        encoded=$(openssl base64 -A < "$tmp")
    else
        return 1
    fi

    if [ "${#encoded}" -gt "$OSC52_MAX" ] && [ -z "${COPYCAT_FORCE:-}" ]; then
        msg "Warning: payload is ${#encoded} bytes (base64), over the OSC52 limit of $OSC52_MAX."
        msg "Most terminals silently drop this. Use COPYCAT_FORCE=1 to try anyway."
        return 1
    fi

    local end
    if [ "$OSC52_TERM" = "st" ]; then end=$'\033\\'; else end=$'\a'; fi
    local seq
    seq=$(printf '\033]52;%s;%s' "$OSC52_TARGET" "$encoded")
    seq="${seq}${end}"

    if [ -n "${TMUX:-}" ]; then
        # Load tmux's own buffer; -w also asks tmux to forward to the system clipboard
        if have tmux; then
            tmux load-buffer -w "$tmp" 2>/dev/null || tmux load-buffer "$tmp" 2>/dev/null
            local pt
            pt=$(tmux show -gv allow-passthrough 2>/dev/null)
            if [ "$pt" != "on" ] && [ "$pt" != "all" ]; then
                msg "Note: tmux allow-passthrough is '${pt:-off}'. Add 'set -g allow-passthrough on' to ~/.tmux.conf"
            fi
        fi
        # DCS passthrough: every ESC inside must be doubled
        printf '\033Ptmux;%s\033\\' "${seq//$'\033'/$'\033\033'}" > /dev/tty
    elif [[ "${TERM:-}" == screen* ]]; then
        # screen drops DCS longer than ~768 bytes, so send in chunks
        printf '%s' "$seq" | fold -w 700 | while IFS= read -r chunk || [ -n "$chunk" ]; do
            printf '\033P%s\033\\' "$chunk"
        done > /dev/tty
    else
        printf '%s' "$seq" > /dev/tty
    fi
    METHOD_USED="OSC52"
}

# ---------- File fallback ----------
copy_file() {
    local dir="${XDG_CACHE_HOME:-$HOME/.cache}/copycat"
    mkdir -p "$dir" 2>/dev/null || dir="${TMPDIR:-/tmp}"
    cp "$tmp" "$dir/last" || return 1
    METHOD_USED="file"
    msg "No clipboard method worked. Saved to: $dir/last"
}
# ---------- Hints ----------
osc52_hints() {
    msg ""
    msg "If nothing pasted, your local terminal is likely blocking OSC52."
    msg "This must be changed on your LOCAL machine, not this server:"

    local t="${TERM_PROGRAM:-}${LC_TERMINAL:-}"
    if   [ -n "${KITTY_WINDOW_ID:-}" ] || [[ "$TERM" == *kitty* ]]; then
        msg "  kitty: add to kitty.conf:  clipboard_control write-clipboard write-primary"
    elif [[ "$t" == *iTerm* ]]; then
        msg "  iTerm2: run on your Mac:  defaults write com.googlecode.iterm2 AllowClipboardAccess -bool true"
        msg "          then restart iTerm2 (or Settings > General > Selection > allow clipboard access)"
    elif [ -n "${ALACRITTY_LOG:-}${ALACRITTY_SOCKET:-}" ] || [[ "$TERM" == alacritty* ]]; then
        msg "  Alacritty: in alacritty.toml add:  [terminal]  osc52 = \"CopyPaste\""
    elif [ -n "${WT_SESSION:-}" ]; then
        msg "  Windows Terminal: supported by default. Paste with Ctrl+Shift+V."
    elif [ -n "${VTE_VERSION:-}" ]; then
        msg "  VTE terminals (GNOME Terminal, Tilix, Terminator) don't support OSC52. Try kitty, WezTerm or Alacritty."
    else
        msg "  Terminal not detected (env vars often aren't forwarded over SSH). Common fixes:"
        msg "    iTerm2:    defaults write com.googlecode.iterm2 AllowClipboardAccess -bool true"
        msg "    kitty:     clipboard_control write-clipboard write-primary"
        msg "    Alacritty: [terminal] osc52 = \"CopyPaste\""
        msg "    PuTTY:     Terminal > Features > allow remote-controlled clipboard access"
        msg "    GNOME Terminal / Terminal.app: unsupported, use another terminal"
    fi

    if [ -n "${TMUX:-}" ]; then
        msg "  tmux (run on this host):"
        msg "    tmux set -g set-clipboard on && tmux set -g allow-passthrough on"
    fi
}
# ---------- Choose order ----------
case "$METHOD" in
    native) order="native" ;;
    osc52)  order="osc52" ;;
    file)   order="file" ;;
    *)
        if is_ssh; then order="osc52 native file"
        else order="native osc52 file"; fi ;;
esac

for m in $order; do
    if "copy_$m"; then
        case "$METHOD_USED" in
            OSC52)
                msg "Sent $label ($bytes bytes) via OSC52 (target=$OSC52_TARGET). Delivery can't be verified."
                msg "If nothing pastes, your terminal is blocking OSC52. Run: copycat --test"
                ;;
            file) ;;
            *) msg "Copied $label ($bytes bytes) to clipboard via $METHOD_USED" ;;
        esac
        exit 0
    fi
done

echo "Error: could not copy to clipboard" >&2
exit 1
